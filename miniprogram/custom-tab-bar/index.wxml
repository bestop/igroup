<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'is-active' : ''}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <image class="tab-item__icon" src="{{selected === index ? item.iconActive : item.icon}}" mode="aspectFit" />
    <text class="tab-item__text">{{item.text}}</text>
  </view>
</view>
