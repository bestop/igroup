.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: #fff;
  border-top: 2rpx solid #F0F0F0;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 10rpx;
  color: #999999;
  transition: color 0.15s ease;
}
.tab-item__icon { width: 46rpx; height: 46rpx; }
.tab-item__text { font-size: 22rpx; margin-top: 4rpx; }
.tab-item.is-active { color: #FF4D4F; font-weight: 600; }
