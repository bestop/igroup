.form-item { margin-bottom: 28rpx; }
.form-item:last-child { margin-bottom: 0; }
.form-item--row { display: flex; gap: 20rpx; }
.form-item--row > view { flex: 1; }
.form-item--mini { flex: 0 0 150rpx !important; }
.form-item--grow { flex: 1; }
.form-item__label { font-size: 28rpx; color: #26292E; margin-bottom: 12rpx; font-weight: 600; }
.form-item__hint { margin-bottom: 20rpx; }
.req { color: var(--red); }

.input {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
}
.input--gap { margin-top: 16rpx; }
.input--inline { flex: 1; margin-left: 20rpx; }
.textarea {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  width: auto;
  min-height: 120rpx;
  box-sizing: border-box;
}

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  background: var(--bg);
  border-radius: 32rpx;
  padding: 12rpx 34rpx;
  font-size: 30rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}
.chip.is-active {
  background: var(--primary-light);
  color: var(--primary-deep);
  border-color: var(--primary);
  font-weight: 600;
}

.picker-box {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
}

.img-picker {
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--bg);
  border: 2rpx dashed #C9CDD3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.img-picker--qr { width: 320rpx; height: 320rpx; }
.img-picker__img { width: 100%; height: 100%; }
.img-picker__empty {
  color: var(--gray);
  font-size: 26rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.img-picker__empty text:first-child { font-size: 60rpx; }

/* 名片区：头像 + 昵称 + 提示 */
.profile-row { align-items: center; }
.profile-fields { flex: 1; min-width: 0; }
.profile-fields__row { display: flex; align-items: center; }
.profile-fields__label { flex-shrink: 0; font-size: 28rpx; color: #26292E; margin-right: 16rpx; }
.profile-fields__input { flex: 1; padding: 16rpx 22rpx; }
.profile-fields__hint { margin-top: 12rpx; font-size: 24rpx; }

.fee-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.fee-row__left {
  display: flex;
  align-items: center;
  min-width: 260rpx;
}
.fee-row__name { margin-left: 16rpx; font-size: 30rpx; }

.radio-row { display: flex; gap: 30rpx; flex-wrap: wrap; }
.radio-item { display: flex; align-items: center; font-size: 28rpx; }

.pay-setting {
  border-top: 2rpx solid var(--gray-light);
  padding: 24rpx 0;
}
.pay-setting:first-of-type { border-top: none; padding-top: 0; }
.pay-setting__name { font-size: 32rpx; font-weight: 600; margin-bottom: 6rpx; }
.pay-setting .input { margin-top: 16rpx; }
.pay-setting .img-picker { margin-top: 20rpx; }

.preview-line { font-size: 32rpx; }
.preview-detail { margin-top: 10rpx; }
.strong { font-weight: 700; }
.hl { color: var(--primary-deep); font-weight: 700; }

.submit-wrap { padding: 30rpx 24rpx 60rpx; }
.submit-tip { text-align: center; margin-top: 16rpx; }
