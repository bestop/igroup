/* 搜索框：全圆角白色长条 */
.search-wrap { padding: 16rpx 24rpx 0; }
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 26, 0.04);
}
.search-box__icon { font-size: 30rpx; margin-right: 14rpx; }
.search-box__input { flex: 1; font-size: 28rpx; }

/* 精选推荐卡片 */
.featured {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.featured__body { flex: 1; min-width: 0; }
.featured__tag {
  display: inline-block;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.featured__title {
  font-size: 36rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.featured__sub { color: var(--muted); font-size: 28rpx; margin-top: 8rpx; }
.featured__foot { color: var(--muted); font-size: 24rpx; margin-top: 14rpx; }
.featured__icon {
  position: relative;
  width: 170rpx;
  height: 170rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}
.featured__img { width: 100%; height: 100%; border-radius: 28rpx; overflow: hidden; }
.featured__emoji { font-size: 80rpx; }
.featured__badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(255, 77, 79, 0.4);
}

/* 模块标题行 */
.module-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 32rpx 8rpx;
}
.module-head__title { font-size: 34rpx; font-weight: 700; }
.module-head__sub { font-size: 24rpx; color: var(--muted); }

/* 双列网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 16rpx 24rpx 0;
}
.grid-item {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(26, 26, 26, 0.04);
  transition: transform 0.15s ease, background-color 0.15s ease;
}
.grid-item__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.grid-item__img { width: 100%; height: 100%; }
.grid-item__title {
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.grid-item__desc {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.grid-item__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.grid-item__stat { color: var(--muted); font-size: 22rpx; }
.grid-item__action { color: var(--primary); font-size: 28rpx; font-weight: 600; }

/* 线性图标适配 */
.search-box__icon { width: 30rpx; height: 30rpx; }
.empty .empty__icon { opacity: 0.9; }
