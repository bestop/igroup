<view class="page-header">
  <view class="page-header__title">我的订单</view>
  <view class="page-header__sub">支付与提货状态都在这里</view>
</view>

<view wx:if="{{!orders.length && !loading}}" class="empty">
  <image class="empty__icon" src="/assets/icons/clipboard-light.png" mode="aspectFit" />
  <view>暂无参与记录</view>
  <view class="muted">去「发现」看看邻居都在拼什么</view>
</view>

<view class="card order" wx:for="{{orders}}" wx:key="pid" hover-class="press">
  <view class="row" data-id="{{item.gb_id}}" bindtap="goDetail">
    <image class="order__img" src="{{item.image_url}}" mode="aspectFill" wx:if="{{item.image_url}}"></image>
    <view class="order__img order__img--placeholder" wx:else><image class="placeholder-ic" src="/assets/icons/cart-light.png" mode="aspectFit" /></view>
    <view class="order__body">
      <view class="row-between">
        <view class="order__name">{{item.store}} · {{item.product_name}}</view>
        <text class="tag tag--{{item.gb_status_view.color}}">{{item.gb_status_view.label}}</text>
      </view>
      <view class="muted">提货：{{item.pickup_location}}</view>
    </view>
  </view>

  <view class="divider"></view>

  <view class="row-between order__pay">
    <view>
      <text>{{item.shares}} {{item.unit}} · 应付 </text>
      <text class="amount"><text class="amount__rmb">¥</text>{{item.amount_text}}</text>
    </view>
    <view class="row order__tags">
      <text class="tag tag--{{item.pay_status_view.color}}">{{item.pay_status_view.label}}</text>
      <text class="muted method" wx:if="{{item.pay_method_text}}">{{item.pay_method_text}}</text>
    </view>
  </view>

  <view class="refund-hint" wx:if="{{item.refund_hint}}">拼单已取消，已付款请联系发起人退款</view>

  <view class="row order__actions">
    <button class="btn btn-mini btn-mini-primary" wx:if="{{item.can_pay}}" data-id="{{item.gb_id}}" bindtap="goPay">去付款</button>
    <button class="btn btn-mini btn-mini-green" wx:if="{{item.can_pickup}}" data-pid="{{item.pid}}" bindtap="onConfirmPickup">确认提货</button>
    <view class="picked-tag" wx:if="{{item.picked_up}}"><image class="ic" src="/assets/icons/check-circle-green.png" mode="aspectFit" />已提货</view>
    <button class="btn btn-mini btn-mini-plain" data-id="{{item.gb_id}}" bindtap="goDetail">查看详情</button>
  </view>
</view>
