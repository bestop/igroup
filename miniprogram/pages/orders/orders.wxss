.order__img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.order__img--placeholder {
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.order__body { flex: 1; min-width: 0; }
.order__name {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order__pay { margin: 4rpx 0; font-size: 30rpx; }
.order__tags { gap: 12rpx; }
.method { font-size: 24rpx; }
.order__actions {
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
}
.picked-tag { font-size: 26rpx; color: var(--green); font-weight: 600; }
.refund-hint {
  margin-top: 14rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}
