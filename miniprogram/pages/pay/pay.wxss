.banner {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}
.banner--red { background: var(--primary-light); color: var(--primary); }

.bill-row {
  display: flex;
  justify-content: space-between;
  font-size: 30rpx;
  padding: 12rpx 0;
  color: #4A4F55;
}
.bill-total__label { font-size: 34rpx; font-weight: 700; }
.bill-total { font-size: 56rpx; font-weight: 700; color: var(--primary); }

.status-card__title { margin-bottom: 0; }
.status-tip {
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
  margin-top: 16rpx;
}
.status-tip--orange { background: var(--orange-light); color: var(--orange); }
.status-tip--green { background: var(--green-light); color: var(--green); }
.status-tip--blue { background: var(--blue-light); color: var(--blue); }
.status-note { margin-top: 14rpx; }
.strong { font-weight: 700; }

/* 方式 Tab 切换 */
.method-tabs {
  display: flex;
  background: var(--bg);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.method-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--muted);
  transition: all 0.15s ease;
}
.method-tab.is-active {
  background: #fff;
  color: var(--primary);
  font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(26, 26, 26, 0.06);
}

/* 收款码：浅色背景卡片衬托，宽度约 80% 屏宽 */
.qr-card {
  display: flex;
  justify-content: center;
  background: var(--bg);
  border-radius: 24rpx;
  padding: 36rpx;
}
.qr-img { width: 520rpx; height: 520rpx; }
.qr-hint {
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  margin-top: 20rpx;
}
.qr-save { margin-top: 20rpx; }
.qr-note {
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-top: 24rpx;
}
.note-label { margin-top: 24rpx; margin-bottom: 12rpx; }

/* 当面支付极简卡片 */
.cash-card {
  background: var(--blue-light);
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  text-align: center;
}
.cash-card__icon { font-size: 72rpx; display: block; margin-bottom: 12rpx; }
.cash-card__title { font-size: 32rpx; font-weight: 700; color: var(--blue); margin-bottom: 10rpx; }
.cash-card .muted { color: #5A8FC4; }
.cash-desc {
  color: #4A4F55;
  font-size: 30rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.pay-foot-hint {
  text-align: center;
  margin-top: 24rpx;
  font-size: 24rpx;
}

.input {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
}

.back-tip { text-align: center; padding: 30rpx 0 60rpx; }
