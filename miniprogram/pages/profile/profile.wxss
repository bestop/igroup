.avatar--plain {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--muted);
}
.profile-name { font-size: 34rpx; font-weight: 700; }

/* 名片展示行：长昵称省略，不把右侧「修改」按钮挤出卡片 */
.profile-head { flex: 1 1 0; min-width: 0; }
.profile-head__meta { flex: 1 1 0; min-width: 0; }
.profile-name,
.profile-head__meta .muted { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 编辑行头像：定宽 72rpx，min/max 双保险，防范 open-type 按钮 UA 默认宽度 */
.avatar-btn--sm {
  flex: 0 0 auto;
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  margin: 0 16rpx 0 0;
  box-sizing: border-box;
}
.avatar-btn--sm .avatar { width: 72rpx; height: 72rpx; }
.avatar-btn--sm .avatar--empty { font-size: 32rpx; }
.avatar-btn--sm .avatar--empty text { font-size: 18rpx; }

/* 弹性收缩由普通 view 包裹层承担：原生 input 不参与 flex 分账，
   规避部分真机上 input 固有宽度不收缩导致整行溢出的怪癖
   （与 detail 页加入拼单表单同款已验证模式） */
.input-wrap { flex: 1 1 0; min-width: 0; overflow: hidden; }
.input {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg);
  border-radius: 14rpx;
  padding: 16rpx 22rpx;
  font-size: 30rpx;
}
.save-btn { flex: 0 0 auto; margin-left: 16rpx; white-space: nowrap; box-sizing: border-box; }

.profile-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  background: var(--bg);
  border-radius: 24rpx;
  padding: 24rpx 0;
}
.profile-stats__item { flex: 1; text-align: center; }
.profile-stats__num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  font-family: "DIN Alternate", "Avenir Next", "Helvetica Neue", sans-serif;
}
.profile-stats__divider { width: 2rpx; height: 56rpx; background: var(--line); }

.menu { padding: 8rpx 30rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
  background: transparent;
  width: 100%;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.4;
  text-align: left;
  border-radius: 0;
  margin: 0;
}
.menu-item::after { border: none; }
.menu-item:last-child { border-bottom: none; }
.menu-item--btn { font-weight: normal; color: var(--text); }
.menu-item__icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-item__text { flex: 1; }
.menu-item__arrow { color: #C9CDD4; font-size: 36rpx; }

.about-foot { text-align: center; padding: 30rpx 0 60rpx; }

/* 线性图标适配 */
.menu-item__icon { width: 36rpx; height: 36rpx; }
.avatar--plain .avatar__glyph { width: 36rpx; height: 36rpx; }
